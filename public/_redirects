# Cloudflare Pages redirects and rewrites

# ========================================
# SPA routing for /app (КРИТИЧНО - обязательно для работы PWA)
# ========================================
# Serve /app and /app/ directly (no redirect chain — important for Google indexing)
/app  /app/index.html  200
/app/  /app/index.html  200
/app/*  /app/index.html  200

# ========================================
# NOTE: Cloudflare Pages automatically redirects .html → non-.html (308)
# We cannot prevent this behavior through _redirects file.
# The non-.html versions will be canonical URLs.
# ========================================

# Legacy redirects (non-.html versions, since Cloudflare strips .html first)
/why-10-minutes  /research/why-10-minutes  301

