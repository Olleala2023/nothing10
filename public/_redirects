# Cloudflare Pages redirects and rewrites

# ========================================
# SPA routing for /app (КРИТИЧНО - обязательно для работы PWA)
# ========================================
# Redirect /app without trailing slash to /app/ (canonical URL)
/app  /app/  301

# All /app/* routes serve the SPA
/app/  /app/index.html  200
/app/*  /app/index.html  200

# ========================================
# Canonical redirects: non-.html → .html
# Cloudflare Pages automatically redirects .html → non-.html (308)
# These rules redirect back to .html versions to establish canonical URLs
# Result: .html URLs are canonical (via double redirect: 308 → 301)
# ========================================
