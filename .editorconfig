# Форматирование, применяемое редактором автоматически.
# Правила из docs/CODE_STYLE.md, которые можно не проверять глазами — живут здесь.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# В Markdown два пробела на конце строки — это перенос строки, их нельзя срезать.
[*.md]
trim_trailing_whitespace = false

[*.{json,webmanifest}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
